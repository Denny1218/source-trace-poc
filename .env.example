APP_HOST=0.0.0.0
APP_PORT=8010

DATABASE_PATH=./data/equipment_change_trace.db

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# STEP 8: Ollama 근거 기반 분석. false로 설정하면 AI 분석만 비활성화되고
# Git/Change Item 검색(Evidence)은 계속 동작합니다.
OLLAMA_ENABLED=true
# Code default: 60. Ops diagnosis may try 120 if tiny-test is slow under load.
OLLAMA_TIMEOUT_SECONDS=60
# Optional separate timeout for GET /api/trace/ollama-test (defaults to above).
# OLLAMA_TEST_TIMEOUT_SECONDS=60
# Top Evidence Links sent to Ollama (alias: TRACE_ANSWER_EVIDENCE_LIMIT).
OLLAMA_MAX_EVIDENCE=3
# TRACE_ANSWER_EVIDENCE_LIMIT=1
# Prompt size knobs (STEP 8 only — Evidence search/link unchanged):
# TRACE_ANSWER_MAX_DIFF_CHARS=300
# TRACE_ANSWER_MAX_FIELD_CHARS=300
# TRACE_ANSWER_MAX_PROMPT_CHARS=12000
TRACE_ANSWER_MAX_DIFF_CHARS=1200
TRACE_ANSWER_MAX_FIELD_CHARS=400
TRACE_ANSWER_MAX_PROMPT_CHARS=12000

PPT_CANDIDATE_LIMIT=30
PPT_CANDIDATE_DATE_RANGE_DAYS=90
PPT_PARSE_LIMIT=10
SLIDE_CANDIDATE_LIMIT=50

LOG_LEVEL=INFO

# Yona 서버 기본 Git Access 계정 (필수). URL에 포함된 Username은 무시됩니다.
# Password는 Git Credential Manager(manager) → Windows Credential Manager에만 저장합니다.
# YONA_DEFAULT_USERNAME=source_trace
# 서버 최초 설치: scripts/setup-yona-credential.bat <host:port> [username]

# (구) YONA_GIT_USERNAME — YONA_DEFAULT_USERNAME 과 동일하게 동작 (하위 호환)
