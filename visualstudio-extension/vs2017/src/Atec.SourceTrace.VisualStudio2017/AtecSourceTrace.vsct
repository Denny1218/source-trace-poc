          <ButtonText>선택 코드 변경 근거 조회</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAtecSourceTraceCmdSet" id="ConfigureCmd" priority="0x0200" type="Button">
        <Parent guid="guidAtecSourceTraceCmdSet" id="AtecSubMenuMainGroup"/>
        <Strings>
          <ButtonText>서버 및 장비 설정...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAtecSourceTraceCmdSet" id="CheckServerCmd" priority="0x0201" type="Button">
        <Parent guid="guidAtecSourceTraceCmdSet" id="AtecSubMenuMainGroup"/>
