          <ButtonText>서버 연결 확인</ButtonText>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidImages" href="Icons\icon16.png" usedList="bmpIcon16"/>
    </Bitmaps>
  </Commands>

