  <Commands package="guidAtecSourceTracePackage">
    <Groups>
      <!-- Context: shell → group → menu → group → buttons -->
      <Group guid="guidAtecSourceTraceCmdSet" id="AtecMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
      <Group guid="guidAtecSourceTraceCmdSet" id="AtecSubMenuGroup" priority="0x0100">
        <Parent guid="guidAtecSourceTraceCmdSet" id="AtecSubMenu"/>
      </Group>
      <!-- Tools: shell → group → menu → group → buttons (DirectTools-proven Tools parent) -->
      <Group guid="guidAtecSourceTraceCmdSet" id="MainMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>
      <Group guid="guidAtecSourceTraceCmdSet" id="AtecSubMenuMainGroup" priority="0x0100">
        <Parent guid="guidAtecSourceTraceCmdSet" id="AtecSubMenuMain"/>
      </Group>
    </Groups>

    <Menus>
      <Menu guid="guidAtecSourceTraceCmdSet" id="AtecSubMenu" priority="0x0100" type="Menu">
        <Parent guid="guidAtecSourceTraceCmdSet" id="AtecMenuGroup"/>
        <Icon guid="guidImages" id="bmpIcon16"/>
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>ATEC Source Trace</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidAtecSourceTraceCmdSet" id="AtecSubMenuMain" priority="0x0100" type="Menu">
        <Parent guid="guidAtecSourceTraceCmdSet" id="MainMenuGroup"/>
        <Strings>
          <ButtonText>ATEC Source Trace</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Buttons>
      <Button guid="guidAtecSourceTraceCmdSet" id="FunctionHistoryCmd" priority="0x0100" type="Button">
        <Parent guid="guidAtecSourceTraceCmdSet" id="AtecSubMenuGroup"/>
