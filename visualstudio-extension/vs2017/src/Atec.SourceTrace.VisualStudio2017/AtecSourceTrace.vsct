          <ButtonText>선택 코드 변경 근거 조회</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAtecSourceTraceCmdSet" id="FunctionHistoryCmdMain" priority="0x0100" type="Button">
        <Parent guid="guidAtecSourceTraceCmdSet" id="AtecSubMenuMainGroup"/>
        <Strings>
          <ButtonText>함수 변경 이력 조회</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAtecSourceTraceCmdSet" id="SelectionTraceCmdMain" priority="0x0101" type="Button">
